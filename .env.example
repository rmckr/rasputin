# Plaintext template for .env -> .env.enc:
#   sops --encrypt --input-type dotenv --output-type dotenv .env > .env.enc
#
# .sops.yaml leaves only HOMELAB_* keys unencrypted (unencrypted_regex
# is an allow-list) and seals everything else. Config changes are
# reviewable in git; credentials stay confidential by default, including
# any new key you add. Add a non-secret key starting with HOMELAB_ if
# you want it readable too.

# Shared config (left unencrypted on purpose)
HOMELAB_DOMAIN=rasputin.pi
HOMELAB_HOST_IP=192.168.188.2
HOMELAB_LAN_CIDR=192.168.188.0/24
HOMELAB_ROUTER_IP=192.168.188.1
HOMELAB_ROUTER_DOMAIN=fritz.box
HOMELAB_TZ=Europe/Berlin
HOMELAB_PUID=1000
HOMELAB_PGID=1000
HOMELAB_LAN_INTERFACE=eth0

# Core
PIHOLE_PASSWORD=

TRAEFIK_ACME_EMAIL=

WG_USERNAME=
WG_PASSWORD=
WG_HOST=

# Metrics
GRAFANA_USERNAME=
GRAFANA_PASSWORD=

INFLUXDB_USERNAME=
INFLUXDB_PASSWORD=
INFLUXDB_TOKEN=

# Mail
DOVECOT_PASSWORD=

IMAPSYNC_USERNAME=
IMAPSYNC_PASSWORD=
IMAPSYNC_HOST=

RSPAMD_PASSWORD=

RSPAMD_ISCAN_USERNAME=
RSPAMD_ISCAN_PASSWORD=
RSPAMD_ISCAN_HOST=

# Apps
HOMEASSISTANT_HOST=

CODE_SERVER_PASSWORD=
CODE_SERVER_SUDO_PASSWORD=
