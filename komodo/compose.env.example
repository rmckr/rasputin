# Komodo bootstrap SECRETS (template).
# Only sensitive values live here; all non-sensitive configuration is
# inline in komodo/compose.yaml (same pattern as the service files).
# Copy to komodo/compose.env, fill in real values, then encrypt:
#   sops --encrypt --input-type dotenv --output-type dotenv komodo/compose.env > komodo/compose.env.enc
# See docs/komodo.md

# ── Database (mongo; also read by Core) ───────────────────────────────
KOMODO_DATABASE_USERNAME=admin
KOMODO_DATABASE_PASSWORD=CHANGE_ME_DB_PASSWORD

# ── Core ──────────────────────────────────────────────────────────────
# Initial admin account created on first boot (change password after login)
KOMODO_INIT_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
# Used to auth incoming webhooks (e.g. GitHub push -> stack redeploy)
KOMODO_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET
# Used to generate JWTs
KOMODO_JWT_SECRET=CHANGE_ME_JWT_SECRET
