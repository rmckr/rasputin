RspamdURL           = "http://rspamd:11334"
RspamdPassword      = "${RSPAMD_PASSWORD}"
ImapAddr            = "${RSPAMD_ISCAN_HOST}"
ImapUser            = "${RSPAMD_ISCAN_USERNAME}"
ImapPassword        = "${RSPAMD_ISCAN_PASSWORD}"
InboxMailbox        = "INBOX"
SpamMailbox         = "INBOX.Spam"
HamMailbox          = "INBOX.Misflagged"
UndetectedMailbox   = "INBOX.Undetected"
BackupMailbox       = "INBOX.Processed"
TempDir             = "/tmp"
KeepTempFiles       = true
ScanMailbox         = "INBOX.Unscanned"
SpamThreshold       = 10.0
# Raw IMAP data can contain credentials, keep this off.
LogIMAPData         = false
